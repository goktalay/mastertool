{
  "name": "master-tool",
  "productName": "Master Tool",
  "version": "1.3.0",
  "description": "Mastertool uygulamalarını tek yerden kurar, açar ve günceller; tek girişle tüm uygulamalarda oturum açar",
  "main": "src/main.js",
  "author": "Mastertool",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "icon": "node scripts/make-icon.js",
    "screenshots": "node scripts/screenshots.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.64.1",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "com.mastertool.app",
    "productName": "Master Tool",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Master-Tool-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Master Tool",
      "include": "build/installer.nsh",
      "menuCategory": "Master Tool"
    },
    "portable": {
      "artifactName": "Master-Tool-Portable-${version}.exe"
    }
  }
}
